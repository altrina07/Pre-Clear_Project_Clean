# Production Environment Variables - S3 + CloudFront Deployment
# Backend: api.pre-clear.app (HTTPS with ACM certificate on ALB)
# Frontend: www.pre-clear.app (CloudFront HTTPS)
# Note: Vite uses VITE_ prefix (not REACT_APP_)

# Backend API URL - Production custom domain with ACM certificate
VITE_API_URL=https://api.pre-clear.app

# No AWS credentials needed in frontend
# Frontend communicates ONLY with backend API
# Backend handles all S3 and Bedrock operations
